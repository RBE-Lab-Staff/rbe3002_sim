<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="small-field">

    <!-- model position in the world -->
    <pose>0 0 0 0 0 0</pose>

    <!-- locked postiton? -->
    <static>true</static>

    <link name="link">
      <!--pose of link relative to model-->
      <pose>0 0 0 0 0 0</pose>

      <!-- visual model-->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://small-field/meshes/3002-small-field.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- collision geometry-->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://small-field/meshes/3002-small-field.dae</uri>
          </mesh>
        </geometry>
      </collision>

      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <sensor name='field_collision' type='contact'>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>

    </link>

    <plugin filename="gz-sim-touchplugin-system" name="gz::sim::systems::TouchPlugin">
      <target>burger</target>
      <namespace>wall</namespace>
      <time>0.1</time>
      <enabled>true</enabled>
    </plugin>
    
  </model>
</sdf>